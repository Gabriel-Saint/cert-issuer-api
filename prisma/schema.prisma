generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntegrationStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CertificateStatus {
  PROCESSING
  ISSUED
  FAILED
  REVOKED
  SUPERSEDED
}

enum DeliveryMode {
  ONLINE
  IN_PERSON
}

model Integration {
  id            String            @id @default(uuid()) @db.Uuid
  namespace     String            @unique @db.VarChar(100)
  displayName   String            @db.VarChar(200)
  institutionId String            @db.VarChar(100)
  status        IntegrationStatus @default(ACTIVE)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(6)
  clients       IntegrationClient[]
  series        CertificateSeries[]
  certificates  Certificate[]
  auditEvents   AuditEvent[]
}

model IntegrationClient {
  id                String            @id @default(uuid()) @db.Uuid
  clientId          String            @unique @db.VarChar(100)
  integrationId     String            @db.Uuid
  secretCiphertext  String            @db.Text
  secretKeyVersion  String            @db.VarChar(100)
  scopes            String[]          @default([])
  status            IntegrationStatus @default(ACTIVE)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  revokedAt         DateTime?         @db.Timestamptz(6)
  integration       Integration       @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  nonces            UsedNonce[]
  idempotencyRecords IdempotencyRecord[]

  @@index([integrationId, status])
}

model UsedNonce {
  id        String           @id @default(uuid()) @db.Uuid
  clientDbId String          @db.Uuid
  nonce     String           @db.VarChar(64)
  expiresAt DateTime         @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  client    IntegrationClient @relation(fields: [clientDbId], references: [id], onDelete: Cascade)

  @@unique([clientDbId, nonce])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id          String            @id @default(uuid()) @db.Uuid
  clientDbId  String            @db.Uuid
  key         String            @db.VarChar(36)
  requestHash String            @db.Char(64)
  state       String            @db.VarChar(30)
  resourceId  String?           @db.Uuid
  expiresAt   DateTime?         @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)
  client      IntegrationClient @relation(fields: [clientDbId], references: [id], onDelete: Cascade)

  @@unique([clientDbId, key])
  @@index([expiresAt])
}

model CertificateSeries {
  id                String          @id @default(uuid()) @db.Uuid
  integrationId     String          @db.Uuid
  identityKey       String          @db.VarChar(1024)
  externalStudentId String          @db.VarChar(128)
  courseId          String          @db.VarChar(128)
  deliveryMode      DeliveryMode
  classId           String?         @db.VarChar(128)
  currentRevision   Int             @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)
  integration       Integration     @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  certificates      Certificate[]

  @@unique([integrationId, identityKey])
  @@index([integrationId, externalStudentId, courseId])
}

model Certificate {
  id                   String            @id @default(uuid()) @db.Uuid
  integrationId        String            @db.Uuid
  seriesId             String            @db.Uuid
  revision             Int
  status               CertificateStatus @default(PROCESSING)
  certificateType      String            @db.VarChar(100)
  verificationCode     String            @unique @db.VarChar(64)
  registrationYear     Int
  registrationSequence Int
  registrationNumber   String            @db.VarChar(40)
  snapshot             Json
  templateVersion      String            @db.VarChar(100)
  pdfObjectKey         String?           @db.VarChar(1024)
  pdfSha256            String?           @db.Char(64)
  pdfSizeBytes         BigInt?
  completedAt          DateTime?         @db.Timestamptz(6)
  revokedAt            DateTime?         @db.Timestamptz(6)
  revocationReason     String?           @db.VarChar(1000)
  supersedesId         String?           @db.Uuid
  failureCode          String?           @db.VarChar(100)
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)
  integration          Integration       @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  series               CertificateSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@unique([seriesId, revision])
  @@unique([integrationId, registrationYear, registrationSequence])
  @@unique([integrationId, registrationNumber])
  @@index([seriesId, status])
  @@index([integrationId, createdAt])
}

model RegistrationCounter {
  institutionId String   @db.VarChar(100)
  year          Int
  lastValue     Int      @default(0)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@id([institutionId, year])
}

model RateLimitBucket {
  bucketKey String   @id @db.VarChar(512)
  tokens    Decimal  @db.Decimal(12, 4)
  updatedAt DateTime @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)

  @@index([expiresAt])
}

model AuditEvent {
  id            String      @id @default(uuid()) @db.Uuid
  integrationId String?     @db.Uuid
  clientId      String?     @db.VarChar(100)
  actorId       String?     @db.VarChar(128)
  eventType     String      @db.VarChar(100)
  outcome       String      @db.VarChar(40)
  requestId     String      @db.VarChar(128)
  reference     String?     @db.VarChar(512)
  details       Json?
  occurredAt    DateTime    @default(now()) @db.Timestamptz(6)
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([integrationId, occurredAt])
  @@index([requestId])
}
