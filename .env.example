# ── Docker Compose ──────────────────────────────────────────────────────────
POSTGRES_DB=cert_api
POSTGRES_USER=cert_api
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_PORT=5433
S3MOCK_API_PORT=9000
S3_BUCKET=certificate-pdfs

# ── Aplicação NestJS ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cert_api:local-postgres-password@localhost:5433/cert_api?schema=public
INTEGRATION_NAMESPACE=local-development
INSTITUTION_ID=local-institution
INTEGRATION_CLIENT_ID=client_local_dev
INTEGRATION_CLIENT_SECRET=0123456789abcdef0123456789abcdef
CERTIFICATE_INSTITUTION_NAME=Instituição de Teste
CERTIFICATE_TEMPLATE_VERSION=local-test-v1
VERIFICATION_BASE_URL=http://localhost:3000/v1/public/certificates
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=local-s3-key
S3_SECRET_KEY=local-s3-secret
INTEGRATION_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
